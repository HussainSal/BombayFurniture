# ── Public (shipped to the browser) ─────────────────────────────
# Canonical site URL — used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_PHONE=+91 90000 00000
NEXT_PUBLIC_EMAIL=hello@example.com

# ── Server-only (NEVER prefix these with NEXT_PUBLIC_) ───────────
# When all three are set, /api/enquiry emails each lead via Resend.
# When unset, enquiries are only written to the server log.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
